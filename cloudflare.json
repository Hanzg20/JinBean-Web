{
  "build": {
    "command": "npm run build",
    "cwd": ".",
    "watch": "npm run dev"
  },
  "routes": {
    "/*": "/index.html"
  },
  "headers": {
    "/*": [
      {
        "key": "X-Content-Type-Options",
        "value": "nosniff"
      },
      {
        "key": "X-Frame-Options",
        "value": "DENY"
      },
      {
        "key": "X-XSS-Protection",
        "value": "1; mode=block"
      },
      {
        "key": "Referrer-Policy",
        "value": "strict-origin-when-cross-origin"
      }
    ],
    "/assets/*": [
      {
        "key": "Cache-Control",
        "value": "public, max-age=31536000, immutable"
      }
    ]
  }
}

